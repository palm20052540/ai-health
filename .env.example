GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/oauth-callback

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-supabase-personal-access-token

HEALTH_USER_ID=00000000-0000-0000-0000-000000000000
HEALTH_SOURCE=pixel_watch
GOOGLE_OAUTH_STATE=replace-with-a-long-random-state-value
SYNC_SHARED_SECRET=replace-with-a-long-random-shared-secret
HEVY_ACTIONS_API_KEY=replace-with-the-custom-gpt-actions-key
AI_HEALTH_PLUGIN_API_KEY=replace-with-a-separate-codex-plugin-key
# Optional dedicated credential accepted only by the private GPT Site proxy.
AI_HEALTH_SITE_API_KEY=replace-with-a-separate-gpt-site-key
# GPT Sites / Worker only. Restrict the API proxy to this signed-in ChatGPT user when configured.
ALLOWED_USER_EMAIL=you@example.com
SYNC_WINDOW_DAYS=7

# Optional for scripts/sync-health-data.ts when calling a local function.
# SYNC_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/sync-health-data
