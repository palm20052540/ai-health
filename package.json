{
  "name": "ai-health",
  "private": true,
  "type": "module",
  "scripts": {
    "supabase": "supabase",
    "check": "deno check supabase/functions/oauth-callback/index.ts supabase/functions/sync-health-data/index.ts scripts/sync-health-data.ts scripts/google-oauth-url.ts",
    "oauth:url": "deno run --allow-env scripts/google-oauth-url.ts",
    "sync": "deno run --allow-env --allow-net scripts/sync-health-data.ts",
    "sync:refresh": "deno run --allow-env --allow-net scripts/sync-health-data.ts --refresh-only"
  },
  "devDependencies": {
    "deno": "2.9.2",
    "supabase": "2.109.1"
  }
}
